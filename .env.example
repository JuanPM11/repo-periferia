# ─────────────────────────────────────────────────────────────
# Variables requeridas. Copia este archivo a .env y completa los valores.
# La clave del modelo vive SOLO aquí (backend). Nunca en el front, el repo ni los logs.
# ─────────────────────────────────────────────────────────────

# Proveedor LLM a usar por el adaptador. Hoy implementado: "anthropic".
LLM_PROVIDER=anthropic

# Modelo del proveedor elegido.
LLM_MODEL=claude-haiku-5-5

# Clave del proveedor. NUNCA se versiona ni se expone por la API.
ANTHROPIC_API_KEY=

# Topes de costo (configurables). Protegen tu clave de un uso ilimitado.
MAX_ITERACIONES=25
MAX_TOKENS_SESION=120000

# Puerto del backend (sirve API + front).
PORT=3000
